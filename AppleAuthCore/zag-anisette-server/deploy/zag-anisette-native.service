# Zag Store native anisette server. Installed by deploy/install-native-anisette.sh;
# see NATIVE_SERVER.md. Loopback only, behind the HTTPS reverse proxy.
[Unit]
Description=Zag Store native anisette server (loopback only)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=zag-anisette
Group=zag-anisette
EnvironmentFile=/etc/zag-anisette/native.env
ExecStart=/usr/local/bin/zag-anisette-server
# Startup runs only the offline native readiness check; it never provisions
# and never contacts Apple. The server stores no client state.
StateDirectory=zag-anisette
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
# SIGTERM ends the server at once; KillMode and the workers' parent-death
# signal end every native worker; the next start removes their directories.
TimeoutStopSec=15s
KillMode=control-group
SendSIGKILL=yes

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# The server needs no outbound network at all: the client talks to Apple.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
# Not set: MemoryDenyWriteExecute, because the Android library loader maps
# CoreADI's code pages itself.
LimitNOFILE=1024
TasksMax=128
MemoryMax=768M

[Install]
WantedBy=multi-user.target
